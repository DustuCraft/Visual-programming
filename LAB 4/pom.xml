<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.shape.Circle?>

<!-- Корневой контейнер - BorderPane: адаптивно перераспределяет top/left/center/bottom -->
<BorderPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="org.example.HelloController"
            styleClass="root-pane"
            prefHeight="700.0" prefWidth="1100.0">

    <!-- ===================== ВЕРХНЯЯ ПАНЕЛЬ ===================== -->
    <top>
        <HBox styleClass="top-bar" alignment="CENTER_LEFT" spacing="15.0" BorderPane.alignment="CENTER">
            <padding>
                <Insets top="12.0" right="20.0" bottom="12.0" left="20.0"/>
            </padding>
            <Label text="Панель мониторинга оборудования" styleClass="title-label"/>
            <!-- Region с HGrow — прижимает кнопки вправо -->
            <Region HBox.hgrow="ALWAYS"/>
            <Button fx:id="btnToggleNav" text="Скрыть навигацию"
                    onAction="#handleToggleNavigation" styleClass="top-button"/>
            <Button text="О программе" onAction="#handleAbout" styleClass="top-button"/>
        </HBox>
    </top>

    <!-- ===================== ЛЕВАЯ НАВИГАЦИЯ (VBox) ===================== -->
    <left>
        <VBox fx:id="navPane" styleClass="nav-pane" spacing="10.0" prefWidth="220.0" BorderPane.alignment="CENTER">
            <padding>
                <Insets top="20.0" right="15.0" bottom="20.0" left="15.0"/>
            </padding>
            <Label text="Навигация" styleClass="nav-title"/>
            <Button text="Все устройства" maxWidth="Infinity" styleClass="nav-button" onAction="#handleFilterAll"/>
            <Button text="Компьютеры" maxWidth="Infinity" styleClass="nav-button" onAction="#handleFilterComputers"/>
            <Button text="Телефоны" maxWidth="Infinity" styleClass="nav-button" onAction="#handleFilterPhones"/>
            <Button text="Роутеры" maxWidth="Infinity" styleClass="nav-button" onAction="#handleFilterRouters"/>
            <!-- Region с VGrow — прижимает счётчик "Онлайн" к низу панели -->
            <Region VBox.vgrow="ALWAYS"/>
            <Separator/>
            <Label fx:id="lblOnlineCount" text="Онлайн: 3 из 3" styleClass="nav-info"/>
        </VBox>
    </left>

    <!-- ===================== ЦЕНТРАЛЬНАЯ ОБЛАСТЬ ===================== -->
    <center>
        <VBox spacing="14.0" styleClass="center-box" BorderPane.alignment="CENTER">
            <padding>
                <Insets top="20.0" right="25.0" bottom="20.0" left="25.0"/>
            </padding>

            <Label text="Состояние оборудования" styleClass="section-title"/>

            <!-- GridPane с карточками устройств -->
            <GridPane hgap="20.0" vgap="20.0" styleClass="devices-grid">
                <columnConstraints>
                    <ColumnConstraints percentWidth="33.3" hgrow="ALWAYS"/>
                    <ColumnConstraints percentWidth="33.3" hgrow="ALWAYS"/>
                    <ColumnConstraints percentWidth="33.3" hgrow="ALWAYS"/>
                </columnConstraints>

                <!-- Карточка "Компьютер": AnchorPane демонстрирует привязку
                     индикатора-кружка к верхнему правому углу карточки -->
                <AnchorPane styleClass="device-card" prefHeight="150.0"
                            GridPane.columnIndex="0" GridPane.rowIndex="0">
                    <VBox alignment="CENTER" spacing="8.0"
                          AnchorPane.topAnchor="0.0" AnchorPane.bottomAnchor="0.0"
                          AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0">
                        <Label text="🖥" styleClass="device-icon"/>
                        <Label text="Компьютер-01" styleClass="device-name"/>
                        <Label fx:id="lblComputerStatus" text="В сети" styleClass="status-online"/>
                    </VBox>
                    <Circle fx:id="dotComputer" radius="6.0" styleClass="status-dot-online"
                            AnchorPane.topAnchor="10.0" AnchorPane.rightAnchor="10.0"/>
                </AnchorPane>

                <!-- Карточка "Телефон" -->
                <AnchorPane styleClass="device-card" prefHeight="150.0"
                            GridPane.columnIndex="1" GridPane.rowIndex="0">
                    <VBox alignment="CENTER" spacing="8.0"
                          AnchorPane.topAnchor="0.0" AnchorPane.bottomAnchor="0.0"
                          AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0">
                        <Label text="📱" styleClass="device-icon"/>
                        <Label text="Телефон-01" styleClass="device-name"/>
                        <Label fx:id="lblPhoneStatus" text="Ожидание" styleClass="status-warning"/>
                    </VBox>
                    <Circle fx:id="dotPhone" radius="6.0" styleClass="status-dot-warning"
                            AnchorPane.topAnchor="10.0" AnchorPane.rightAnchor="10.0"/>
                </AnchorPane>

                <!-- Карточка "Роутер" -->
                <AnchorPane styleClass="device-card" prefHeight="150.0"
                            GridPane.columnIndex="2" GridPane.rowIndex="0">
                    <VBox alignment="CENTER" spacing="8.0"
                          AnchorPane.topAnchor="0.0" AnchorPane.bottomAnchor="0.0"
                          AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0">
                        <Label text="📡" styleClass="device-icon"/>
                        <Label text="Роутер-01" styleClass="device-name"/>
                        <Label fx:id="lblRouterStatus" text="Не в сети" styleClass="status-offline"/>
                    </VBox>
                    <Circle fx:id="dotRouter" radius="6.0" styleClass="status-dot-offline"
                            AnchorPane.topAnchor="10.0" AnchorPane.rightAnchor="10.0"/>
                </AnchorPane>
            </GridPane>

            <Button text="Обновить статус" onAction="#handleRefreshStatus" styleClass="refresh-button"/>

            <Separator/>

            <Label text="Параметры записи" styleClass="section-title"/>

            <!-- GridPane с полями: устройство + форма обучения -->
            <GridPane hgap="15.0" vgap="12.0" styleClass="params-grid">
                <columnConstraints>
                    <ColumnConstraints minWidth="150.0" hgrow="NEVER"/>
                    <ColumnConstraints hgrow="ALWAYS"/>
                </columnConstraints>

                <Label text="Устройство:" GridPane.columnIndex="0" GridPane.rowIndex="0"/>
                <ComboBox fx:id="cbDevice" maxWidth="Infinity" GridPane.columnIndex="1" GridPane.rowIndex="0"/>

                <Label text="Форма обучения:" GridPane.columnIndex="0" GridPane.rowIndex="1"/>
                <ComboBox fx:id="cbForm" maxWidth="Infinity" GridPane.columnIndex="1" GridPane.rowIndex="1"/>
            </GridPane>

            <Label text="Примечание:" styleClass="section-title"/>
            <!-- TextArea с вертикальным ростом -->
            <TextArea fx:id="taNote" promptText="Введите примечание к состоянию оборудования..."
                      wrapText="true" VBox.vgrow="ALWAYS"/>

        </VBox>
    </center>

    <!-- ===================== НИЖНЯЯ СТРОКА СОСТОЯНИЯ ===================== -->
    <bottom>
        <HBox styleClass="status-bar" alignment="CENTER_LEFT" spacing="10.0" BorderPane.alignment="CENTER">
            <padding>
                <Insets top="6.0" right="20.0" bottom="6.0" left="20.0"/>
            </padding>
            <Label fx:id="lblStatusBar" text="Готово" styleClass="status-bar-label"/>
        </HBox>
    </bottom>

</BorderPane>